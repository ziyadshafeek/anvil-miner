// Vulkan 1.1 compute benchmark kernel — SHA-256, NOT RandomX, NOT pool mining.
//
// Each invocation hashes one 64-byte block: buffer layout per element is
// 16 uint32 words, big-endian word order as stored by the host (the host
// writes the padded "abc" block for element 0, and nonce blocks for the
// rest). Output per element is 8 uint32 words (the SHA-256 digest).
//
// Shared memory: this kernel does NOT use shared memory for its
// 64-word schedule, because 64 threads each needing 64 words would
// exceed any per-workgroup shared budget. Each thread keeps its
// schedule in private registers. A future kernel that shares a small
// state across a workgroup could use up to 16 KB of shared memory,
// but that is not what this kernel does, and no Tile Local Storage
// benefit is claimed for it.
// Valhall's 16-wide subgroups are a hardware property, not a shader
// guarantee, and no subgroup builtin is used here, so the kernel does
// not claim a subgroup size it cannot enforce.
// This kernel never parses stratum jobs, never checks a pool difficulty
// target, and never submits a share. Quoting its output as GPU mining
// earnings would be false.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer InBuf { uint in_words[]; };
layout(set = 0, binding = 1) writeonly buffer OutBuf { uint out_words[]; };
shared uint s_w[256];
const uint K[64] = uint[64](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u);

uint rotr(uint x, uint n) { return (x >> n) | (x << (32u - n)); }

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint base_in = gid * 16u;
    uint base_out = gid * 8u;
    uint w[64];
    for (uint i = 0u; i < 16u; i++) {
        uint word = in_words[base_in + i];
        // Host stores words little-endian in memory; SHA-256 works
        // big-endian, so byte-swap each word here.
        word = ((word & 0x000000ffu) << 24u) | ((word & 0x0000ff00u) << 8u) |
               ((word & 0x00ff0000u) >> 8u) | ((word & 0xff000000u) >> 24u);
        w[i] = word;
    }
    for (uint i = 16u; i < 64u; i++) {
        uint s0 = rotr(w[i - 15u], 7u) ^ rotr(w[i - 15u], 18u) ^ (w[i - 15u] >> 3u);
        uint s1 = rotr(w[i - 2u], 17u) ^ rotr(w[i - 2u], 19u) ^ (w[i - 2u] >> 10u);
        w[i] = w[i - 16u] + s0 + w[i - 7u] + s1;
    }
    uint h0 = 0x6a09e667u, h1 = 0xbb67ae85u, h2 = 0x3c6ef372u, h3 = 0xa54ff53au;
    uint h4 = 0x510e527fu, h5 = 0x9b05688cu, h6 = 0x1f83d9abu, h7 = 0x5be0cd19u;
    uint a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, hh = h7;
    // K constants are inlined via a helper array built from the standard
    // SHA-256 table (see vulkan_miner.cpp comment: the table is the
    // published FIPS 180-4 table, not a measured value).
    for (uint i = 0u; i < 64u; i++) {
        uint k = K[i];
        uint S1 = rotr(e, 6u) ^ rotr(e, 11u) ^ rotr(e, 25u);
        uint ch = (e & f) ^ ((~e) & g);
        uint t1 = hh + S1 + ch + k + w[i];
        uint S0 = rotr(a, 2u) ^ rotr(a, 13u) ^ rotr(a, 22u);
        uint maj = (a & b) ^ (a & c) ^ (b & c);
        uint t2 = S0 + maj;
        hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
    }
    uint res[8];
    res[0] = h0 + a; res[1] = h1 + b; res[2] = h2 + c; res[3] = h3 + d;
    res[4] = h4 + e; res[5] = h5 + f; res[6] = h6 + g; res[7] = h7 + hh;
    for (uint i = 0u; i < 8u; i++) out_words[base_out + i] = res[i];
}
