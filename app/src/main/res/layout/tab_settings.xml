<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chargingOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:padding="12dp"
            android:text="Charging only"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Mine only while plugged in"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/bigOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Big cores only (2 threads, pinned)"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Pins mining to the 2 fastest cores found on this phone, via sysfs. Test every rung — big-only, 25%, 50%, 75%, 100% — and keep the highest SUSTAINED 60-second hashrate over 30 minutes, not the highest burst. Safety pauses stay on."
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/asymmetric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Asymmetric (2 big + 2 little, pinned)"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Same pool-assigned algorithm on all 4 threads, big cores first. This is a test of whether little cores add sustained H/s or steal L3/bus. Not two algorithms at once."
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/l3Isolated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="L3-isolated per-algo (rx=big, light=little)"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Per-algo thread arrays: rx/0, rx/wow, cn-heavy and cn/ccx run on big cores only; cn-pico, cn-lite, cn and cn/r run on little cores only. Still one algorithm at a time — XMRig restarts workers when the pool changes algorithm — so this isolates rx work in time, it does not run two algorithms at once."
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/updateCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:padding="12dp"
            android:text="Check for updates"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Checks only this fork's GitHub releases. Turn off to stop all update checks."
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/gcspcSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:padding="12dp"
            android:text="APK2: predictive step-down (GCSPC)"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="APK2 only. Steps down one thread rung BEFORE the hard heat pause, then holds 30 minutes. Safety pauses are unchanged and still apply. Turn off to behave like APK1."
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/wifiOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Wi-Fi only"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Pause mining on mobile data"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#2A2A2A" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/quietHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Quiet hours"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:id="@+id/quietPickers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quietStart"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start 22:00"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quietEnd"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="End 07:00"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Pause mining between these times, including overnight."
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#2A2A2A" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/blackholeBench"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:text="Run blackhole self-tests (once, fixed header)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Runs the fixed blackhole header tests once on tap only, on the test thread only: pin return codes and read-back mask, allocator alignment and madvise return, nbits, word-7 overflow. It does not pin XMRig workers, does not change the dataset, and does not check shares. Result is logged."
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gpuBench"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:text="Run native GPU bench (once, SHA-256 test)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Runs the Vulkan SHA-256 benchmark kernel once (not pool mining). It does not submit shares and does not change your Monero earnings. Result is shown as a message and logged."
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openLog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:text="XMRig output log"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rebench"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:text="Re-benchmark algorithm"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openAbout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:text="About, license, privacy"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:text="@string/footer_info"
            android:textColor="#BDBDBD"
            android:textColorLink="#FF6B35"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
