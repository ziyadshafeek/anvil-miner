<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wallet"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#B71C1C"
            android:padding="12dp"
            android:text="STOP. NEVER type your seed phrase here. This app will NEVER ask for your seed phrase, private key, or wallet password. Your seed phrase is 25 secret words. Anyone who has them can take your money. Keep those words on paper, offline. Never paste them into any app, website, or chat. This app needs only ONE thing: your public receiving address. That address is safe to share. It starts with 4. It cannot spend your money."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/walletStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/walletStepBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E0E0E0"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/walletStepPrev"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous step"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/walletStepNext"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next step"
                android:textAllCaps="false" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/walletAboutMoneyBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About your money — read this before you expect payment"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/walletAboutMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Who pays you? MoneroOcean is the mining pool. It is a company that runs the pool. It is NOT fully no-custody. The pool counts your work and sends the payment to your wallet. You do not need a MoneroOcean account, but the pool is still in the middle. That is different from mining with no pool at all. How much, and when? The pool pays only when your balance reaches about 0.003 XMR. At 400 to 600 hashes per second, that takes about 73 to 104 days. That is an estimate, not a promise. Speed, price, and pool rules can change. Your earnings will go up and down. They are not fixed pay. A phone earns roughly $0.50 to $1 a month in the estimates used here, before battery wear. It will not reliably earn $10 a month. Tax in India: when you convert crypto to rupees, India charges 30% tax on crypto gains, plus 1% TDS. Keep a record of what you receive and when. This app does not file tax for you. Your money is not held by this miner app. This app never holds your XMR. Payment goes from the pool to the wallet address you pasted."
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Saved address (display only) -->
        <LinearLayout
            android:id="@+id/walletSaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your XMR address"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1E1E1E"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/walletDisplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="#FFFFFF"
                                        android:textSize="12sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/verifyMo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Verify on MoneroOcean"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#FF6B35" />

            <TextView
                android:id="@+id/workerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeWallet"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Change Address"
                android:textAllCaps="false"
                android:textColor="#FF6B35"
                app:strokeColor="#FF6B35" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mining payments are non-custodial. Your address goes to MoneroOcean over TLS. Anvil never holds your XMR. Tap Verify on MoneroOcean to confirm hashrate and shares on the pool’s own site."
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- First setup / change address -->
        <LinearLayout
            android:id="@+id/walletEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/walletEditTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Enter your Monero (XMR) wallet address"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/wallet_hint"
                app:boxBackgroundMode="outline"
                app:hintTextColor="#FF6B35">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/wallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="3"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/pasteWallet"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Paste wallet"
                    android:src="@drawable/ic_paste"
                    android:tint="#E0E0E0" />

                <ImageButton
                    android:id="@+id/scanWallet"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Scan wallet QR"
                    android:src="@drawable/ic_scan"
                    android:tint="#E0E0E0" />
            </LinearLayout>

            <TextView
                android:id="@+id/walletError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#EF5350"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/wallet_tip"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveWallet"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="#FF6B35" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelWallet"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#BDBDBD"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your address is passed directly to the MoneroOcean pool. Anvil never holds your XMR."
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
