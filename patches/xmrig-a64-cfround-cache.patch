 	// msr fpcr, tmp_reg
 	emit32(0xD51B4400 | tmp_reg, code, k);
 
+	prevCFROUNDPos = (int32_t)startPos;
+	prevCFROUNDLen = (k - startPos) / 4;
 	codePos = k;
 }
 
